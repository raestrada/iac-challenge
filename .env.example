# GitHub configuration for GitOps
# Used by Flux to connect to your GitHub repository
GITHUB_ORG=my-github-org
GITHUB_REPO=iac-challenge
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GCP configuration
# The GCP project where resources will be created
GCP_PROJECT_ID=my-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Path to service account key file with appropriate permissions
# This service account needs permissions for:  
# - Cloud SQL Admin
# - Kubernetes Engine Admin
# - Service Account User
GCP_CREDENTIALS_PATH=/path/to/service-account-key.json

# PostgreSQL configuration (for GCP Cloud SQL)
# Values used by the PostgreSQL Terraform module
POSTGRES_INSTANCE_NAME=my-postgres-instance
POSTGRES_TIER=db-f1-micro       # Smallest tier for cost savings
POSTGRES_STORAGE_SIZE=10        # Storage in GB
POSTGRES_VERSION=13             # PostgreSQL version
POSTGRES_DB_NAME=mydatabase
POSTGRES_USER=dbuser
# Note: If left empty, a random password will be generated
POSTGRES_PASSWORD=

# GKE configuration
# Values used by the GKE Terraform module
GKE_CLUSTER_NAME=my-gke-cluster
GKE_SIZE=small                   # Options: small, medium, large

# Application configurations
# Used for Spring Boot application
APP_NAME=spring-boot-app
APP_VERSION=1.0.0
APP_NAMESPACE=default

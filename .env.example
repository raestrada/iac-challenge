# GitHub configuration for GitOps
GITHUB_ORG=my-github-org
GITHUB_REPO=my-repo-name
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GCP configuration
GCP_PROJECT_ID=my-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
# Path to service account key file with appropriate permissions
GCP_CREDENTIALS_PATH=/path/to/service-account-key.json

# PostgreSQL configuration (for GCP Cloud SQL)
POSTGRES_INSTANCE_NAME=my-postgres-instance
POSTGRES_TIER=db-g1-small
POSTGRES_STORAGE_SIZE=10
POSTGRES_VERSION=15
POSTGRES_DB_NAME=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Application configurations
APP_NAME=spring-boot-app
APP_VERSION=1.0.0
APP_NAMESPACE=default
